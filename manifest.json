{
  "_comment": "Slack App Manifest for Prime Bot (Socket Mode)",
  "display_information": {
    "name": "Prime",
    "description": "Local observation bot connected via Socket Mode",
    "background_color": "#1A1D21"
  },
  "features": {
    "bot_user": {
      "display_name": "Prime",
      "always_online": true
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "im:history",
        "mpim:history",
        "chat:write",
        "reactions:write",
        "users:read"
      ]
    }
  },
  "settings": {
    "socket_mode_enabled": true,
    "event_subscriptions": {
      "bot_events": [
        "app_mention",
        "message.im"
      ]
    },
    "org_deploy_enabled": false
  }
}
