# Bot User OAuth Token (from OAuth & Permissions page)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# App-Level Token with 'connections:write' scope (from Basic Information -> App-Level Tokens)
SLACK_APP_TOKEN=xapp-your-app-token-here

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: API Client implementation type ('web' [default] or 'cli')
# - 'web': Uses SlackWebClient (in-process persistent HTTPS, ~370ms)
# - 'cli': Uses SlackCliClient (external `slack api` subprocess, ~1650ms)
SLACK_API_CLIENT_TYPE=web
